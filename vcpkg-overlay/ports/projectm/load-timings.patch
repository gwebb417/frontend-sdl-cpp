diff --git a/src/libprojectM/PresetLoadTimings.hpp b/src/libprojectM/PresetLoadTimings.hpp
new file mode 100644
index 0000000..75e1301
--- /dev/null
+++ b/src/libprojectM/PresetLoadTimings.hpp
@@ -0,0 +1,49 @@
+#pragma once
+
+// projectMSDL fork patch: timings of the last preset load, to find what makes preset switches stutter.
+
+#include <chrono>
+
+namespace libprojectM {
+
+struct PresetLoadTimings {
+    double fileMs{};            //!< Reading and setting up the preset (incl. shader preprocessing).
+    double expressionsMs{};     //!< Compiling the expressions and running the init code.
+    double shaderTranslateMs{}; //!< Translating the warp and composite shaders from HLSL to GLSL.
+    double shaderCompileMs{};   //!< Compiling and linking the shaders in the graphics driver.
+    double initialImageMs{};    //!< Drawing the previous preset's image into the new one.
+    double totalMs{};           //!< The whole load.
+
+    static auto Last() -> PresetLoadTimings&
+    {
+        static PresetLoadTimings timings;
+        return timings;
+    }
+};
+
+/**
+ * @brief Adds the time since construction to a timing value when destroyed.
+ */
+class ScopedLoadTimer
+{
+public:
+    explicit ScopedLoadTimer(double& target)
+        : m_target(target)
+        , m_start(std::chrono::steady_clock::now())
+    {
+    }
+
+    ~ScopedLoadTimer()
+    {
+        m_target += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - m_start).count();
+    }
+
+    ScopedLoadTimer(const ScopedLoadTimer&) = delete;
+    ScopedLoadTimer& operator=(const ScopedLoadTimer&) = delete;
+
+private:
+    double& m_target;
+    std::chrono::steady_clock::time_point m_start;
+};
+
+} // namespace libprojectM
