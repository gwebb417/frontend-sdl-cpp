+void projectm_get_last_preset_load_timings(projectm_handle /* instance */, projectm_preset_load_timings* timings)
+{
+    if (timings == nullptr)
+    {
+        return;
+    }
+    const auto& last = libprojectM::PresetLoadTimings::Last();
+    timings->file_ms = last.fileMs;
+    timings->expressions_ms = last.expressionsMs;
+    timings->shader_translate_ms = last.shaderTranslateMs;
+    timings->shader_compile_ms = last.shaderCompileMs;
+    timings->initial_image_ms = last.initialImageMs;
+    timings->total_ms = last.totalMs;
+}
