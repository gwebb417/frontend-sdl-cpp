diff --git a/src/libprojectM/TimeKeeper.cpp b/src/libprojectM/TimeKeeper.cpp
index 612b0ab..d10509d 100644
--- a/src/libprojectM/TimeKeeper.cpp
+++ b/src/libprojectM/TimeKeeper.cpp
@@ -23,6 +23,33 @@ void TimeKeeper::UpdateTimers()
     m_currentTime = currentFrameTime;
     m_presetFrameA++;
     m_presetFrameB++;
+
+    m_animationSecondsSinceLastFrame = m_secondsSinceLastFrame * m_animationSpeed;
+    m_animationTime += m_animationSecondsSinceLastFrame;
+
+    // Smooth the frame time a little so normal frame-to-frame jitter doesn't make the motion uneven,
+    // and limit it so a stall (e.g. while dragging the window) doesn't cause a big jump.
+    double frameSeconds = std::min(std::max(m_secondsSinceLastFrame, 0.0), 0.25);
+    if (m_smoothedFrameSeconds <= 0.0)
+    {
+        m_smoothedFrameSeconds = frameSeconds;
+    }
+    else
+    {
+        m_smoothedFrameSeconds += (frameSeconds - m_smoothedFrameSeconds) * 0.1;
+    }
+
+    double frameShare = 1.0;
+    if (m_motionReferenceFps > 0.0 && m_smoothedFrameSeconds > 0.0)
+    {
+        frameShare = std::min(std::max(m_smoothedFrameSeconds * m_motionReferenceFps, 0.05), 4.0);
+    }
+    m_motionScale = frameShare * m_animationSpeed;
+}
+
+void TimeKeeper::SetAnimationSpeed(double speed)
+{
+    m_animationSpeed = std::min(std::max(speed, 0.0), 4.0);
