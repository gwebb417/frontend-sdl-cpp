+/**
+ * @brief Sets the preset animation speed (projectMSDL fork patch).
+ *
+ * Slows down or speeds up everything a preset animates: the "time" variable, audio value smoothing and the
+ * per-frame motion (zoom, rotation, warp, translation, stretch) and decay. Preset display, transition and
+ * hard cut durations keep using real seconds.
+ *
+ * @param instance The projectM instance handle.
+ * @param speed 1.0 = normal speed, 0.5 = half speed. Clamped to 0.0 - 4.0.
+ */
+PROJECTM_EXPORT void projectm_set_animation_speed(projectm_handle instance, float speed);
+
+/**
+ * @brief Returns the preset animation speed (projectMSDL fork patch).
+ * @param instance The projectM instance handle.
+ * @return The animation speed.
+ */
+PROJECTM_EXPORT float projectm_get_animation_speed(projectm_handle instance);
+
+/**
+ * @brief Makes per-frame preset motion independent of the frame rate (projectMSDL fork patch).
+ *
+ * Milkdrop presets apply their zoom, rotation, warp, translation, stretch and decay once per frame, so they
+ * move faster at higher frame rates. With a reference FPS, the motion runs at the speed it has at that frame
+ * rate, regardless of the actual frame rate.
+ *
+ * @param instance The projectM instance handle.
+ * @param fps The reference frame rate, e.g. 60. 0 = stock behavior (motion per frame).
+ */
+PROJECTM_EXPORT void projectm_set_motion_reference_fps(projectm_handle instance, float fps);
+
