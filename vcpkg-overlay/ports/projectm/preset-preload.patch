+    m_preloadTimings.preloaded = true;
+    timings = lastSwitchTimings;
+    return preloaded;
+}
+
+auto ProjectM::ContinuePreload() -> bool
+{
+    if (!m_preloadedPreset || !m_preloadNeedsInitialize)
+    {
+        return m_preloadedPreset != nullptr;
+    }
+    m_preloadNeedsInitialize = false;
+
+    auto& timings = PresetLoadTimings::Last();
+    const auto lastSwitchTimings = timings;
+    timings = m_preloadTimings;
+
+    bool initialized{false};
+    try
+    {
+        ScopedLoadTimer totalTimer(timings.totalMs);
+        Renderer::Shader::BeginDeferredChecks(m_preloadedPrograms);
+        try
+        {
+            m_preloadedPreset->Initialize(GetRenderContext());
+        }
+        catch (...)
+        {
+            Renderer::Shader::EndDeferredChecks();
+            throw;
+        }
+        Renderer::Shader::EndDeferredChecks();
+        initialized = true;
+    }
+    catch (const std::exception&)
+    {
+        // Failed presets are reported when they are actually loaded.
+        ClearPreloadedPreset();
+    }
+
+    m_preloadTimings = timings;
+    timings = lastSwitchTimings;
+    return initialized;
+}
+
+auto ProjectM::PreloadedPresetReady() -> bool
+{
+    // The first call after PreloadPresetFile() does the second half of the preload.
+    if (m_preloadNeedsInitialize)
+    {
+        ContinuePreload();
+        return false;
+    }
+    return m_preloadedPreset != nullptr && Renderer::Shader::ProgramsReady(m_preloadedPrograms);
+}
+
+void ProjectM::ClearPreloadedPreset()
+{
+    m_preloadNeedsInitialize = false;
+    Renderer::Shader::ReleaseDeferredShaders(m_preloadedPrograms);
+    m_preloadedPreset.reset();
+    m_preloadedPrograms.clear();
+    m_preloadedPresetFile.clear();
+}
+
+auto ProjectM::SwitchToPreloadedPreset(const std::string& presetFilename, bool smoothTransition) -> bool
+{
+    if (!m_preloadedPreset)
+    {
+        return false;
+    }
+    if (presetFilename != m_preloadedPresetFile)
+    {
+        ClearPreloadedPreset();
+        return false;
+    }
+
+    // Switching before the second half of the preload ran: do it now.
+    if (!ContinuePreload())
+    {
+        return false;
+    }
+
+    auto preset = std::move(m_preloadedPreset);
+    auto programs = std::move(m_preloadedPrograms);
+    ClearPreloadedPreset();
+
+    auto& timings = PresetLoadTimings::Last();
+    timings = m_preloadTimings;
+    auto switchStart = std::chrono::steady_clock::now();
+
+    bool linked;
+    {
+        ScopedLoadTimer waitTimer(timings.waitMs);
+        linked = Renderer::Shader::ProgramsLinked(programs);
+    }
+    if (!linked)
+    {
+        // A shader failed to compile. A normal load handles that, e.g. with the fallback shaders.
+        return false;
+    }
+
+    try
+    {
+        StartPresetTransition(std::move(preset), !smoothTransition, true);
+    }
+    catch (const std::exception& ex)
+    {
+        PresetSwitchFailedEvent(presetFilename, ex.what());
+    }
+    timings.switchMs = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - switchStart).count();
+    return true;
+}
