+auto ProjectM::PreloadPresetFile(const std::string& presetFilename) -> bool
+{
+    ClearPreloadedPreset();
+
+    // The timers inside the preset write to PresetLoadTimings::Last(), keep the last switch's values there.
+    auto& timings = PresetLoadTimings::Last();
+    const auto lastSwitchTimings = timings;
+    timings = PresetLoadTimings{};
+
+    bool preloaded{false};
+    try
+    {
+        ScopedLoadTimer totalTimer(timings.totalMs);
+        m_textureManager->PurgeTextures();
+        std::unique_ptr<Preset> preset;
+        {
+            ScopedLoadTimer fileTimer(timings.fileMs);
+            preset = m_presetFactoryManager->CreatePresetFromFile(presetFilename);
+        }
+        if (preset)
+        {
+            // Initialized in the next frame, see ContinuePreload(), so the work is split over two frames.
+            m_preloadedPreset = std::move(preset);
+            m_preloadedPresetFile = presetFilename;
+            m_preloadNeedsInitialize = true;
+            preloaded = true;
+        }
+    }
+    catch (const std::exception&)
+    {
+        // Failed presets are reported when they are actually loaded.
+        ClearPreloadedPreset();
+    }
