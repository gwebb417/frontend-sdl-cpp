 namespace libprojectM {
 namespace Renderer {
 
+#ifndef GL_COMPLETION_STATUS_KHR
+#define GL_COMPLETION_STATUS_KHR 0x91B1
+#endif
+
+namespace {
+std::vector<GLuint>* deferredPrograms{nullptr}; //!< projectMSDL fork patch: see Shader::BeginDeferredChecks().
+
+// Shader objects of deferred programs. They stay attached until the driver finished linking, because
+// detaching them right after glLinkProgram() makes some drivers wait for the compile to finish.
+std::map<GLuint, std::vector<GLuint>> deferredShaders;
+
+void ReleaseShaders(GLuint program)
+{
+    auto entry = deferredShaders.find(program);
+    if (entry == deferredShaders.end())
+    {
+        return;
+    }
+    for (auto shader : entry->second)
+    {
+        if (glIsProgram(program))
+        {
+            glDetachShader(program, shader);
+        }
+        glDeleteShader(shader);
+    }
+    deferredShaders.erase(entry);
+}
+
+auto ParallelCompileSupported() -> bool
+{
+    static int supported = -1;
+    if (supported < 0)
+    {
+        supported = 0;
+        GLint extensionCount{};
+        glGetIntegerv(GL_NUM_EXTENSIONS, &extensionCount);
+        for (GLint index = 0; index < extensionCount; index++)
+        {
+            const auto* name = reinterpret_cast<const char*>(glGetStringi(GL_EXTENSIONS, static_cast<GLuint>(index)));
+            if (name != nullptr &&
+                (std::string(name) == "GL_KHR_parallel_shader_compile" || std::string(name) == "GL_ARB_parallel_shader_compile"))
+            {
+                supported = 1;
+                break;
+            }
+        }
+    }
+    return supported == 1;
+}
+} // namespace
+
+void Shader::BeginDeferredChecks(std::vector<GLuint>& programs)
+{
+    deferredPrograms = &programs;
+}
+
+void Shader::EndDeferredChecks()
+{
+    deferredPrograms = nullptr;
+}
+
+auto Shader::ProgramsReady(const std::vector<GLuint>& programs) -> bool
+{
+    if (!ParallelCompileSupported())
+    {
+        return true;
+    }
+    for (auto program : programs)
+    {
+        if (!glIsProgram(program))
+        {
+            continue;
+        }
+        GLint done{GL_TRUE};
+        glGetProgramiv(program, GL_COMPLETION_STATUS_KHR, &done);
+        if (done != GL_TRUE)
+        {
+            return false;
+        }
+        ReleaseShaders(program);
+    }
+    return true;
+}
+
+void Shader::ReleaseDeferredShaders(const std::vector<GLuint>& programs)
+{
+    for (auto program : programs)
+    {
+        ReleaseShaders(program);
+    }
+}
+
+auto Shader::ProgramsLinked(const std::vector<GLuint>& programs) -> bool
+{
+    for (auto program : programs)
+    {
+        if (!glIsProgram(program))
+        {
+            continue;
+        }
+        GLint linked{GL_FALSE};
+        glGetProgramiv(program, GL_LINK_STATUS, &linked);
+        ReleaseShaders(program);
+        if (linked != GL_TRUE)
+        {
+            return false;
+        }
+    }
+    return true;
+}
