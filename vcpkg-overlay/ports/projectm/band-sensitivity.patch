+void PCM::SetBandFrequencies(float sampleRate, const float* hz)
+{
+    Loudness* bands[3]{&m_bass, &m_middles, &m_treble};
+    for (int band = 0; band < 3; band++)
+    {
+        if (sampleRate <= 0.0f || hz == nullptr)
+        {
+            bands[band]->SetBinRange(0, 0);
+            continue;
+        }
+
+        // The spectrum has SpectrumSamples bins from 0 Hz to half the sample rate.
+        // Bin 0 (constant offset) is never used, and each band gets at least one bin.
+        float const binsPerHz = static_cast<float>(SpectrumSamples * 2) / sampleRate;
+        int startBin = std::max(1, static_cast<int>(std::lround(hz[band * 2] * binsPerHz)));
+        int endBin = std::max(startBin + 1, static_cast<int>(std::lround(hz[band * 2 + 1] * binsPerHz)));
+        bands[band]->SetBinRange(startBin, std::min(endBin, SpectrumSamples));
+    }
+}
