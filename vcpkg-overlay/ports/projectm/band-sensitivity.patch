+void ProjectM::SetBandSensitivity(float bass, float mid, float treble)
+{
+    auto clampSensitivity = [](float value) {
+        return std::min(std::max(0.0f, value), 2.0f);
+    };
+    m_bassSensitivity = clampSensitivity(bass);
+    m_midSensitivity = clampSensitivity(mid);
+    m_trebleSensitivity = clampSensitivity(treble);
+}
