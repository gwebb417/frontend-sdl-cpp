 auto TransitionShaderManager::RandomTransition() -> std::shared_ptr<Shader>
 {
-    if (m_transitionShaders.empty())
+    // projectMSDL fork patch: pick only from the enabled effects that compiled. If none of the
+    // enabled ones are usable (or the mask is 0), pick from all usable effects, so transitions never stop.
+    std::vector<size_t> usable;
+    std::vector<size_t> enabled;
+    for (size_t index = 0; index < m_transitionShaders.size(); index++)
+    {
+        if (!m_transitionShaders[index])
+        {
+            continue;
+        }
+        usable.push_back(index);
+        if (index < 32 && (m_enabledEffects & (1u << index)) != 0)
+        {
+            enabled.push_back(index);
+        }
+    }
+
+    const auto& candidates = enabled.empty() ? usable : enabled;
+    if (candidates.empty())
     {
         return {};
     }
 
-    return m_transitionShaders.at(m_mersenneTwister() % m_transitionShaders.size());
+    return m_transitionShaders.at(candidates.at(m_mersenneTwister() % candidates.size()));
+}
